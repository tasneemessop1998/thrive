rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Public profile: what friends see. Holds no email address.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && me() == uid;
      allow update: if signedIn() && (
        me() == uid ||
        // friends may only add one kudos at a time
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudos']) &&
         request.resource.data.kudos == (resource.data.get('kudos', 0) + 1))
      );
      match /private/{doc} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // Find-by-email: you can look up an address you already know, but never list them.
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == me() && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /circles/{code} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && resource.data.by == me();
      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && me() == uid;
      }
      match /nudges/{id} {
        allow read: if signedIn() && (resource.data.to == me() || resource.data.from == me());
        allow create: if signedIn() && request.resource.data.from == me();
      }
      match /quests/{id}   { allow read, create, update: if signedIn(); }
      match /sessions/{id} { allow read, create, update: if signedIn(); }
    }

    // Messages: only the two people in a conversation can read or write it.
    // The conversation id is the two user ids, sorted, joined with "_".
    match /dm/{pair} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create, update: if signedIn() && me() in request.resource.data.users && me() in pair.split('_');
      match /msgs/{id} {
        allow read: if signedIn() && me() in pair.split('_');
        allow create: if signedIn() && me() in pair.split('_') && request.resource.data.from == me();
      }
    }
  }
}
